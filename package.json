{
  "name": "profit-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev:api": "pnpm --filter @pi/api dev",
    "dev:web": "pnpm --filter @pi/web dev",
    "dev:worker": "pnpm --filter @pi/worker dev",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "health": "node scripts/health-check.mjs",
    "db:create": "pnpm --filter @pi/db cli create",
    "db:migrate": "pnpm --filter @pi/db cli migrate",
    "db:roles": "pnpm --filter @pi/db cli roles",
    "db:setup": "pnpm --filter @pi/db cli setup",
    "db:seed": "pnpm --filter @pi/db cli seed",
    "db:reset": "pnpm --filter @pi/db cli reset",
    "db:generate": "pnpm --filter @pi/db exec drizzle-kit generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:fast": "node scripts/check-fast.mjs",
    "test:load": "vitest run --config vitest.load.config.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "graph:refresh": "py -3 -X utf8 scripts/graphify-refresh.py",
    "shopify:dev": "shopify app dev",
    "shopify:deploy": "shopify app deploy",
    "shopify:info": "shopify app info",
    "seed:shopify": "pnpm --filter @pi/seed seed",
    "seed:counts": "pnpm --filter @pi/seed counts",
    "seed:daily": "pnpm --filter @pi/seed daily",
    "seed:marketing": "pnpm --filter @pi/seed marketing",
    "seed:shipping": "pnpm --filter @pi/seed shipping",
    "sync:verify": "pnpm --filter @pi/seed verify",
    "profit:verify": "pnpm --filter @pi/seed profit-verify",
    "audit:secrets": "node scripts/secrets.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "backup:verify": "node --env-file=.env scripts/restore-test.mjs",
    "audit:deps": "pnpm audit --prod --audit-level=high",
    "db:check": "node --env-file=.env scripts/db-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shopify/cli": "^4.9.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "pg": "^8.23.1"
  }
}
