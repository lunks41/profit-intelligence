{"nodes": [{"id": "settings", "label": "Settings: Costs and Rules", "file_type": "document", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "settings_costs", "label": "Variant Cost Settings", "file_type": "code", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET and PUT /api/v1/settings/costs. A cost for the same date replaces the earlier one, which stays in history. Dates cannot be in the future or before 2000."}, {"id": "settings_rules", "label": "Fee and Shipping Rules", "file_type": "code", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payment fee rules are percent plus fixed, per gateway or all. Shipping cost rules are flat or a percent of shipping charged. The missing-cost warning limit is also set here."}, {"id": "settings_fill_gaps", "label": "fill_gaps Recalculation", "file_type": "rationale", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving a cost or rule does not change past orders by itself. Apply to existing orders prices orders whose cost was missing and applies fee and shipping rules. Costs already used on past orders stay."}, {"id": "settings_everything", "label": "everything Recalculation", "file_type": "rationale", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recalculate everything also redoes costs already used, can change figures already seen, needs a second confirmation in the UI, and is written to the audit trail."}, {"id": "settings_session", "label": "Shop Taken From Session", "file_type": "rationale", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The shop is always taken from the session token. No shop or tenant id is accepted from the client. A cost, rule, or audit row of another shop is never readable or removable (404). Every change records the Shopify user id from the session token."}, {"id": "settings_gift_card", "label": "Gift Cards Cannot Have a Cost", "file_type": "rationale", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "settings_queries", "label": "packages/db/src/settings.ts", "file_type": "code", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "settings_writes", "label": "packages/db/src/profit.ts", "file_type": "code", "source_file": "docs/architecture/settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes costs and rules and the audit trail."}], "edges": [{"source": "profit_engine_setting", "target": "settings_rules", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architecture/settings.md", "source_location": null, "weight": 1.0}, {"source": "settings", "target": "settings_costs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/settings.md", "source_location": null, "weight": 1.0}, {"source": "settings", "target": "settings_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/settings.md", "source_location": null, "weight": 1.0}, {"source": "settings_costs", "target": "profit_engine_cost", "relation": "