{"nodes": [{"id": "profit_engine_doc", "label": "Profit Engine", "file_type": "document", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "profit_engine_package", "label": "Profit Engine Package", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "packages/profit-engine. Money, rounding, currency conversion, calculateOrder, summarize, and confidence. No database, no clock, no network. Financial rules exist only in the engine. The API, the worker, and the database never re-implement a formula."}, {"id": "profit_engine_calculate", "label": "calculateOrder", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "profit_engine_summarize", "label": "summarize", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "profit_engine_spec", "label": "Profit Calculation Spec", "file_type": "document", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "profit_engine_ledger", "label": "f_profit_entry", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ledger: one row per component per event with date in the shop time zone, amount, status, source, basis, and engine version. Every number is a sum of these rows."}, {"id": "profit_engine_order", "label": "f_order_profit", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per order: counted or why not, review flags, partial flag, and order business date."}, {"id": "profit_engine_cost", "label": "f_product_cost", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effective-dated cost per variant. Append-only; revoke instead of edit. The unit cost used for a line is stored with its ledger entry and reused by routine recalculations. Only an explicit force recalculation applies a new cost. A cost with a later effective date never changes older orders."}, {"id": "profit_engine_fee_rule", "label": "s_payment_fee_rule", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Estimate rule, effective dated, append-only."}, {"id": "profit_engine_shipping_rule", "label": "s_shipping_cost_rule", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Estimate rule, effective dated, append-only."}, {"id": "profit_engine_setting", "label": "s_app_setting", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing-cost warning threshold, default 10%."}, {"id": "profit_engine_job", "label": "profit.recalculate", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/worker profit/recalculate.ts. Runs the engine over orders 100 per transaction and replaces each order's ledger. Triggered when sync finishes or an order or refund webhook arrives. Idempotent: rows are replaced, never appended, and the order row is locked first so overlapping runs cannot duplicate."}, {"id": "profit_engine_missing", "label": "Missing Amount Is Not Invented", "file_type": "rationale", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing cost, fee, or shipping cost is an entry with status missing and amount 0, counted in the confidence and shown as partial profit."}, {"id": "profit_engine_decimal", "label": "Exact Decimal Money", "file_type": "rationale", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "decimal.js, stored as NUMERIC(19,4), rounded once per entry to the currency minor unit, half away from zero."}, {"id": "profit_engine_measure_first", "label": "Measure First", "file_type": "rationale", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no daily summary table yet because sums over the indexed ledger are cheap. A summary table will be added when a measurement shows it is needed. Spec section 11."}, {"id": "profit_engine_append_only", "label": "Append-only Costs, Rules, and Audit", "file_type": "rationale", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The application role has UPDATE only on the revoked columns of cost and rule tables and no UPDATE on the audit log. a_audit_log is never updated."}, {"id": "profit_engine_verify", "label": "pnpm profit:verify", "file_type": "code", "source_file": "docs/architecture/profit-engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Against the dev store, revenue plus tax equals Shopify's order total on every counted order, every refund reconciles to the money returned, and the approved examples reproduce to the cent."}], "edges": [{"source": "readme_packages_profit_engine", "target": "profit_engine_package", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architecture/profit-engine.md", "source_location": null, "weight": 1.0}, {"source": "profit_engine_doc", "target": "profit_engine_spec", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profit-engine.md", "source_location": null, "weight": 1.0}, {"source": "profit_engine_doc", "target": "profit_engine_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profit-engine.md", "source_location": null, "weight": 1.0}, {"source": "profit_engine_package", "target": "profit_engine_calculate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profit-engine.md", "source_location": null, "weight": 1.0}, {"source": "profit_engine_package", "target": "profit_engine_summarize", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profit-engine.md", "source_location": null, "weight": 1.0}, {"source": "profit_engine_package", "target": "profit_engine_decimal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profit-engine.md", "source_location": null, "weight": 1.0}, {"source": "profit_engine_job", "target": "profit_engine_calculate", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profit-engine.md", "so