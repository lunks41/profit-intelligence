{"nodes": [{"id": "webhooks_document", "label": "Webhooks and Incremental Sync", "file_type": "document", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "webhooks_hmac_verification", "label": "HMAC-SHA256 Webhook Verification", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing else is trusted first. The signature is HMAC-SHA256 over the exact raw body with a constant-time compare, so a forged, tampered, or unsigned request is 401 and is not stored."}, {"id": "webhooks_o_webhook_event", "label": "o_webhook_event", "file_type": "code", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique on shop_id plus X-Shopify-Webhook-Id so a Shopify redelivery is a duplicate acknowledgement. Concurrent duplicates yield one row and one job. Rows store topic, ids, and status, never payloads."}, {"id": "webhooks_webhook_process", "label": "webhook.process Job", "file_type": "code", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The API enqueues the job and answers 200 within milliseconds. If enqueue fails, the event row is removed and the API returns 500 so Shopify's retry is treated as new work."}, {"id": "webhooks_process_webhook", "label": "processWebhook", "file_type": "code", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The handler never trusts the webhook payload. It re-reads the resource from Shopify and upserts only data that is new or newer, so out-of-order delivery stays correct."}, {"id": "webhooks_nightly_reconcile", "label": "Nightly Reconcile", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delivery is at-least-once and not ordered, so correctness cannot depend on payloads. At 03:00 UTC the job asks what changed since the last good sync minus one day; Sundays re-check the full 90-day window. It cannot yet detect an order deleted in Shopify while its webhook was missed."}, {"id": "webhooks_app_uninstalled", "label": "app/uninstalled", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The token is removed, running syncs are cancelled, the shop is marked uninstalled, and a purge is scheduled in 30 days."}, {"id": "webhooks_shop_redact", "label": "shop/redact", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory privacy topic. All data of the shop is deleted immediately, overriding the uninstall grace period."}, {"id": "webhooks_customer_privacy_ack", "label": "Customer Privacy Webhook Acknowledgement", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "customers/redact and customers/data_request are acknowledged with no export or erasure because no customer personal data is stored."}, {"id": "webhooks_ids_only_payloads", "label": "Webhook IDs Only", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order, refund, and product subscriptions request include_fields ids only so customer data is never delivered to the app."}, {"id": "webhooks_order_history_window", "label": "90-Day Order History Window", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only orders inside the 90-day window are stored. A webhook for an older order that is not held is ignored, but an order already held is still updated so late refunds are applied."}, {"id": "webhooks_event_retention_14d", "label": "Webhook Event Retention", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Event rows without payloads are deleted after 14 days by a nightly cleanup at 03:30 UTC."}, {"id": "webhooks_pg_boss_retry", "label": "pg-boss Webhook Retries", "file_type": "rationale", "source_file": "docs/architecture/webhooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failed processing is retried 8 times with backoff. Permanent failure is recorded on the event. A revoked token stops retries and flags the shop for reconnection."}], "edges": [{"source": "webhooks_document", "target": "webhooks_hmac_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_document", "target": "webhooks_o_webhook_event", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_document", "target": "webhooks_webhook_process", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_document", "target": "webhooks_process_webhook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_document", "target": "webhooks_nightly_reconcile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_hmac_verification", "target": "webhooks_o_webhook_event", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_o_webhook_event", "target": "webhooks_webhook_process", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_process_webhook", "target": "webhooks_webhook_process", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_pg_boss_retry", "target": "webhooks_webhook_process", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_ids_only_payloads", "target": "webhooks_customer_privacy_ack", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_nightly_reconcile", "target": "webhooks_order_history_window", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "securityreview_with_tenant", "target": "webhooks_webhook_process", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_pg_boss_retry", "target": "adr0001_pg_boss", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_no_customer_pii", "target": "webhooks_ids_only_payloads", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}, {"source": "webhooks_document", "target": "adr0001_nextjs", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/architecture/webhooks.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "incremental_sync_correctness", "label": "Incremental Sync Correctness", "nodes": ["webhooks_hmac_verification", "webhooks_o_webhook_event", "webhooks_webhook_process", "webhooks_process_webhook", "webhooks_nightly_reconcile", "webhooks_pg_boss_retry"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/webhooks.md"}]}