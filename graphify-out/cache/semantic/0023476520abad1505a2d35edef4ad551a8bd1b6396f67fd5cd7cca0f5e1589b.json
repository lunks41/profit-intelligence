{"nodes": [{"id": "profitability", "label": "Product and Order Profitability", "file_type": "document", "source_file": "docs/architecture/profitability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "profitability_products", "label": "Product Profitability Endpoints", "file_type": "code", "source_file": "docs/architecture/profitability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /api/v1/profitability/products and products/detail. Tenant-scoped, session required. Periods use the same presets and rules as the Overview. Amounts are in the shop currency."}, {"id": "profitability_orders", "label": "Order Profitability Endpoints", "file_type": "code", "source_file": "docs/architecture/profitability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /api/v1/profitability/orders and orders/:id. One order returns every ledger entry with a plain-language explanation, a per-product split, and unallocated items."}, {"id": "profitability_allocation", "label": "Approved Allocation Rule", "file_type": "rationale", "source_file": "docs/architecture/profitability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sales and discounts are split in proportion to each line's value before discount. A refund goes to the lines that were refunded. Product cost is already per line. Shipping charged, shipping refunded, payment fees, and shipping cost stay with the order and are shown as unallocated. Splitting uses whole minor units and largest remainder so the parts always add up exactly."}, {"id": "profitability_allocate", "label": "packages/profit-engine/src/allocate.ts", "file_type": "code", "source_file": "docs/architecture/profitability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure and unit tested."}, {"id": "profitability_reconcile", "label": "Contribution Profit Reconciliation", "file_type": "rationale", "source_file": "docs/architecture/profitability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For a period, sum of product profit plus unallocated equals dashboard contribution profit, to the cent. Order profits also add up to the dashboard figure. Only entries dated inside the period are allocated, so refunds land in the period of the refund, a cash view, as on the Overview."}, {"id": "profitability_explain", "label": "Ledger Explainability", "file_type": "rationale", "source_file": "docs/architecture/profitability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each ledger entry returns a label, its data quality (confirmed, estimated, or missing), its source, and a sentence saying how it was worked out. A missing cost is described as unknown, never as zero."}, {"id": "profitability_measure", "label": "Allocate in Application Code", "file_type": "rationale", "source_file": "docs/architecture/profitability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Product figures are allocated in application code per request because exact cent-level splitting is awkward in SQL. This is fine for typical periods; measure before adding a summary table. Order lists are paged in SQL."}], "edges": [{"source": "profitability", "target": "profitability_products", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability", "target": "profitability_orders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability_products", "target": "dashboard_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability_allocation", "target": "profitability_allocate", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability_allocate", "target": "profit_engine_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability_reconcile", "target": "dashboard_overview", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability_reconcile", "target": "profit_engine_ledger", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability_orders", "target": "profit_engine_ledger", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability_explain", "target": "profit_engine_ledger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/profitability.md", "source_location": null, "weight": 1.0}, {"source": "profitability_explain", "target": "profit_engine_missing", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architect