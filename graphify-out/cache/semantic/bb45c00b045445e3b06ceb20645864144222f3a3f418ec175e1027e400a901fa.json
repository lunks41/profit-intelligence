{"nodes": [{"id": "monitoring_document", "label": "Monitoring", "file_type": "document", "source_file": "docs/operations/monitoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "monitoring_ops_monitor", "label": "ops.monitor", "file_type": "code", "source_file": "docs/operations/monitoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The worker runs ops.monitor every 15 minutes and writes one warning per problem as a structured JSON log line with a stable event name such as sync_stale, webhook_backlog, or delivery_failed. Each stale shop is also told once a day."}, {"id": "monitoring_health_endpoints", "label": "Health Endpoints", "file_type": "code", "source_file": "docs/operations/monitoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worker GET /status returns problem counts and names no shop, order, or customer. GET /health is liveness. pnpm health checks web, API, and worker. The status port stays on the private network."}, {"id": "monitoring_in_memory_rate_limit", "label": "In-Memory Rate Limit", "file_type": "rationale", "source_file": "docs/operations/monitoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rate-limit counters live in each API process. With more than one process the limit applies per process, so the counter must move to the database or a cache before scaling out."}], "edges": [{"source": "monitoring_document", "target": "monitoring_ops_monitor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/monitoring.md", "source_location": null, "weight": 1.0}, {"source": "monitoring_document", "target": "monitoring_health_endpoints", "relation": "references", "confidence": "EXTRACTED", "confidenc