{"nodes": [{"id": "leakage", "label": "Profit Leakage and Data Quality", "file_type": "document", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "leakage_evaluate", "label": "evaluateLeakage", "file_type": "code", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "packages/reports/src/leakage.ts. A pure function: the same figures and limits always give the same findings, so every finding can be reproduced from the numbers on screen."}, {"id": "leakage_finding", "label": "Leakage Finding", "file_type": "rationale", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A finding states a measured fact (evidence), why it matters (why), where to act (action), and, only when it is defensible, the money involved (impact). Impact is always a loss and always has a note."}, {"id": "leakage_missing", "label": "Missing Data Is Never Guessed", "file_type": "rationale", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An order that looks negative but is missing a cost is only a possible loss with no money figure. A product without a cost is not judged, and the finding says how many were skipped."}, {"id": "leakage_sample", "label": "Small Sample Gate", "file_type": "rationale", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A margin or refund rate needs at least 10 orders. A product margin needs at least 3 units. Small samples are not judged."}, {"id": "leakage_limits", "label": "Merchant Alert Limits", "file_type": "rationale", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Limits belong to the merchant in Settings, Alerts. Every comparison is strict: exactly at the limit raises nothing."}, {"id": "leakage_loss_orders", "label": "loss_orders", "file_type": "rationale", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical when orders with every cost known have negative profit. Money figure is the total loss of those orders."}, {"id": "leakage_possible_loss", "label": "possible_loss", "file_type": "rationale", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Info when profit is negative but a cost is missing. No money figure."}, {"id": "leakage_daily", "label": "Daily Leakage Check", "file_type": "code", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 05:00 UTC the last 30 days are checked. Warning and critical findings create a notification once per week per rule. Informational findings never interrupt. Plans without leakage findings get neither the tab nor the notifications."}, {"id": "leakage_monitoring", "label": "System Monitoring", "file_type": "document", "source_file": "docs/architecture/leakage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/worker/src/monitoring is separate from merchant findings. See docs/operations/monitoring.md."}], "edges": [{"source": "leakage", "target": "billing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/leakage.md", "source_location": null, "