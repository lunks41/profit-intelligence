{"nodes": [{"id": "roadmap", "label": "Product Roadmap", "file_type": "document", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_benchmark", "label": "Competitor Benchmark", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written 2026-10-09 against TrueProfit, BeProfit, Lifetimely by AMP, MerchantFlow, PodVector, and Triple Whale. ProfitFly was not found on the Shopify App Store so it is not compared. Competitor facts come from public listings and may be out of date."}, {"id": "roadmap_trueprofit", "label": "TrueProfit", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_beprofit", "label": "BeProfit", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_lifetimely", "label": "Lifetimely", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cohorts, LTV, and CAC payback are Lifetimely's core."}, {"id": "roadmap_merchantflow", "label": "MerchantFlow", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bank reconciliation for untracked expenses is a MerchantFlow idea."}, {"id": "roadmap_podvector", "label": "PodVector", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_triple_whale", "label": "Triple Whale", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First-party pixel attribution and creative analytics are Triple Whale's core."}, {"id": "roadmap_v1", "label": "V1 Launch Scope", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The smallest product merchants will pay for. The first six items decide whether the profit figure is right and whether the app can be approved and sold."}, {"id": "roadmap_meta_google_ads", "label": "Meta and Google Ads Integration", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily spend sync by campaign, blended ROAS and MER, and profit after ads. Every compared competitor has live ad spend; manual entry cannot be the product. The owner must create the Meta and Google developer apps because review takes weeks."}, {"id": "roadmap_payment_fees", "label": "Actual Shopify Payments Fees", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Balance transactions replace the estimate that currently flags every order. Gateway rules stay for PayPal and others. Needs the payments read scope and a Shopify Payments store to test."}, {"id": "roadmap_shipping_zones", "label": "Shipping Cost by Zone, Country and Weight", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most unprofitable-order warnings today come from shipping cost missing. Includes CSV import."}, {"id": "roadmap_cogs_csv", "label": "Product Cost CSV and Bulk Edit", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Import, export, and bulk edit by product, variant, collection, and vendor. Today costs are edited on a per-product screen."}, {"id": "roadmap_live_billing", "label": "Live Billing and Plans", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose managed pricing or the Billing API, approve prices, and switch BILLING_MODE on. Trial, upgrade, and downgrade must be tested. Prices are an owner decision."}, {"id": "roadmap_app_store", "label": "App Store Readiness", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 14: HTTPS hosting, monitoring alerts, backups restored, privacy policy, support contact, listing text and screenshots, read_all_orders approval or a 60-day history, performance and accessibility, and rotation of the leaked Shopify secret."}, {"id": "roadmap_exchange_rates", "label": "Exchange Rates for Any Currency", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A daily rates source is needed. Today only USD and AED are supported."}, {"id": "roadmap_email", "label": "Production Email Delivery", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SMTP or a mail service for scheduled reports and alerts. The code is done; the owner provides the account."}, {"id": "roadmap_email_alerts", "label": "Email Alerts", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Margin drop, loss orders, missing costs, and failed sync. Today they are in-app only."}, {"id": "roadmap_read_all_orders", "label": "read_all_orders Launch Decision", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner must choose whether to apply for read_all_orders or limit history to 60 days at launch."}, {"id": "roadmap_ltv_privacy", "label": "LTV and Cohort Privacy Boundary", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer lifetime value, cohorts, and CAC payback need customer-level data and Shopify approval for protected customer data. That would change the privacy position because the app deliberately stores no customer personal data today."}, {"id": "roadmap_utm", "label": "Order-to-Campaign UTM Attribution", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V2. Profit per campaign, not just per account. Shopify orders are not matched to campaigns yet."}, {"id": "roadmap_pixel", "label": "First-party Pixel Attribution", "file_type": "rationale", "source_file": "docs/roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V3. Triple Whale's core. Heavy engineering and a privacy review."}], "edges": [{"source": "roadmap", "target": "roadmap_benchmark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/roadmap.md", "source_location": null, "weight": 1.0}, {"source": "roadmap_benchmark", "target": "roadmap_trueprofit", "relation": "references", "