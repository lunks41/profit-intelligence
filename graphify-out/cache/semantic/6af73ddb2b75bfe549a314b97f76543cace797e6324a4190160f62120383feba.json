{"nodes": [{"id": "deploymentchecklist_document", "label": "Production Readiness Checklist", "file_type": "document", "source_file": "docs/operations/deployment-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploymentchecklist_assert_production_config", "label": "assertProductionConfig", "file_type": "code", "source_file": "docs/operations/deployment-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production start-up refuses unsafe settings and lists them without printing secret values: NODE_ENV, https APP_URL, database TLS, a fresh TOKEN_ENCRYPTION_KEY, the production Shopify secret, and billing test mode off."}, {"id": "deploymentchecklist_read_all_orders", "label": "read_all_orders Before Launch", "file_type": "rationale", "source_file": "docs/operations/deployment-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orders older than 60 days need read_all_orders. The app keeps 90 days, so launch requires that approval or the history window must be lowered to 60 days."}, {"id": "deploymentchecklist_tls_proxy", "label": "TLS Reverse Proxy", "file_type": "rationale", "source_file": "docs/operations/deployment-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TLS terminates at the reverse proxy. The web app forwards /api/v1 to the API on a private address. API and web send HSTS. The worker port and API port are not exposed directly."}], "edges": [{"source": "deploymentchecklist_document", "target": "backuprestore_document", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/deployment-checklist.md", "source_location": null, "weight": 1.0}, {"source": "deploymentchecklist_document", "target": "