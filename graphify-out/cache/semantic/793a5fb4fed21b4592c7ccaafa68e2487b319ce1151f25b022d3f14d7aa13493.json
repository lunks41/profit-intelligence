{"nodes": [{"id": "database", "label": "Database", "file_type": "document", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "database_prompt_32", "label": "Prompt Section 32 Naming Rules", "file_type": "document", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "database_postgres", "label": "PostgreSQL 17", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "database_drizzle", "label": "Drizzle ORM", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviewed SQL migrations live in packages/db/migrations. Never edit an applied migration. Production migrations run with owner credentials from the deployment environment, not from a developer machine."}, {"id": "database_m_tenant", "label": "m_tenant", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merchant account and the isolation boundary. Status is active, suspended, or deleted."}, {"id": "database_m_shop", "label": "m_shop", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shopify store installation. UNIQUE(shopify_domain) and UNIQUE(tenant_id, id), which is the target of composite foreign keys."}, {"id": "database_credential", "label": "s_shop_credential", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encrypted offline access token. Composite foreign key (tenant_id, shop_id) to m_shop so a credential cannot point at another tenant's shop."}, {"id": "database_with_tenant", "label": "withTenant", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the callback in a transaction after set_config('app.tenant_id', id, true). The setting is transaction-local so it never leaks across pooled connections."}, {"id": "database_app_current_tenant", "label": "app_current_tenant", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Policies use app_current_tenant(), which is NULL when unset, so no rows match. Fail closed."}, {"id": "database_resolve_tenant", "label": "resolveTenantByShopDomain", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only bootstrap lookup. It sets app.shop_domain and a read-only policy lets the matching m_shop row be selected. Pass only a domain already verified from a Shopify session token or webhook HMAC. Tenant ids and domains must come from server-side verified context, never from request input."}, {"id": "database_rls", "label": "Forced Row Level Security", "file_type": "rationale", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every migration that creates a table must GRANT to app_user, enable and force RLS, and add a policy. A test fails if a table lacks forced RLS or a policy."}, {"id": "database_app_user", "label": "app_user", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DATABASE_URL role used by the api and the worker. DML on listed tables only. Not superuser, no BYPASSRLS, cannot create objects."}, {"id": "database_admin", "label": "DATABASE_ADMIN_URL", "file_type": "code", "source_file": "docs/architecture/database.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner and migrator role. Used by migrations and db commands only. Owns the tables."}], "edges": [{"source": "database", "target": "database_prompt_32", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/database.md", "source_location": null, "weight": 1.0}, {"source": "readme_packages_db", "target": "database_drizzle", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architecture/database.md", "source_location": null, "weight": 1.0}, {"source": "database", "target": "database_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/database.md", "source_location": null, "weight": 1.0}, {"source": "database", "target": "database_drizzle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/database.md", "source_location": null, "weight": 1.0}, {"source": "database_drizzle", "target": "database_m_tenant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/database.md", "source_location": null, "weight": 1.0}, {"source": "database_drizzle", "target": "database_m_shop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/database.md", "source_location": null, "weight": 1.0}, {"source": "databas