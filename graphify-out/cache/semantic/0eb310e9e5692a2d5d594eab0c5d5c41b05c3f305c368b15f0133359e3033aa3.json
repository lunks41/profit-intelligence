{"nodes": [{"id": "reports", "label": "Reports, Exports and Notifications", "file_type": "document", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_package", "label": "@pi/reports", "file_type": "code", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The package builds reports. The API shows them and the worker prepares files. Both use the same code, so the screen, the CSV, and the PDF always show the same figures."}, {"id": "reports_builders", "label": "Report Builders", "file_type": "code", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "packages/reports/src/builders.ts. profit_loss, products, orders, marketing, and expenses. A report is a plain table of strings: money as exact decimals, formatted only for reading."}, {"id": "reports_profit_loss", "label": "Profit and Loss Report", "file_type": "rationale", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One column per calendar month plus a total. Within a month, revenue less costs gives contribution profit, and less advertising and expenses gives net profit. Tested to the cent against the Overview."}, {"id": "reports_export", "label": "o_report_export", "file_type": "code", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /api/v1/reports/exports queues a background job. The worker builds CSV or A4 landscape PDF, stores up to 20 MB, and keeps it 7 days. Only the worker that moves the export from queued to running does the work. Failures are stored, a critical notification is created, and the merchant can retry. At most 5 exports waiting or running per shop."}, {"id": "reports_csv", "label": "CSV Formula Guard", "file_type": "rationale", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text cells that start with =, +, -, or @ get a leading apostrophe so a product or order name cannot run as a spreadsheet formula. Numbers are never altered. UTF-8 with a byte order mark so Excel reads it. Download needs the session token and nosniff, no-store, attachment headers."}, {"id": "reports_schedule", "label": "s_report_schedule", "file_type": "code", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weekly on a weekday or monthly on the 1st, at an hour, in the shop time zone, up to 5 recipients and 10 schedules."}, {"id": "reports_occurrence", "label": "latestOccurrence", "file_type": "code", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "packages/reports/src/schedule.ts. Answers when the schedule last fired and which period it covers from the clock alone, so a worker that was down at the scheduled hour catches up, and the answer is the same however often it is asked."}, {"id": "reports_claim", "label": "Schedule Period Claim", "file_type": "rationale", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The period end is claimed in one UPDATE WHERE last_period_end is older, before anything is queued, so overlapping schedulers or a restart cannot send a period twice. A new schedule starts with the next firing and does not send the period that has just passed. One delivery row exists per export and recipient."}, {"id": "reports_smtp", "label": "SMTP Email", "file_type": "rationale", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses SMTP_URL and MAIL_FROM. Without it every delivery is marked failed with a clear message and can be retried once mail is set up. Each recipient succeeds or fails on its own."}, {"id": "reports_notification", "label": "o_notification", "file_type": "code", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shown on the Reports screen and as a one-line reminder on the Overview. A dedupe_key stops the same event creating two messages."}, {"id": "reports_retention", "label": "Seven-day Export Retention", "file_type": "rationale", "source_file": "docs/architecture/reports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Export files are deleted after 7 days by the nightly cleanup deleteExpiredExports. Purging a shop removes its exports, schedules, deliveries, and notifications."}], "edges": [{"source": "reports", "target": "billing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/reports.md", "source_location": null, "weight": 1.0}, {"source": "reports_notification", "target": "dashboard_ui", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/reports.md", "source_location": null, "weight": 1.0}, {"source": "reports_builders", "target": "expenses_ad_spend", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/architecture/reports.md", "source_location": null, "weight": 1.0}, {"source": "reports_builders", "target": "expenses_f_