{"nodes": [{"id": "expenses_advertising", "label": "Expenses and Advertising", "file_type": "document", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "expenses_f_expense", "label": "f_expense", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "expenses_category", "label": "f_expense_category", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "expenses_override", "label": "f_expense_override", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces or skips one month of a recurring expense. Saving the same month twice replaces it."}, {"id": "expenses_for_period", "label": "expensesForPeriod", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "packages/profit-engine/src/expenses.ts. Occurrences are computed, never stored, so a retried request or job cannot create a duplicate charge. One-time counts in full on its date. Monthly spreads each month evenly over its days with cumulative rounding so adjacent periods add up to the whole month. Yearly counts in full on each anniversary, a cash view like refunds; 29 February falls on 28 February in a normal year."}, {"id": "expenses_replaces", "label": "Expense Amount Versioning", "file_type": "rationale", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changing an amount closes the old row the day before the first month it applies to and starts a new row via replaces_id, so earlier months keep the amount that applied then. The database only lets end_date and revoked_at change on an existing expense."}, {"id": "expenses_request_key", "label": "Expense requestKey", "file_type": "rationale", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creating is safe to retry. The same requestKey in the same shop returns the first expense instead of adding another."}, {"id": "expenses_audit", "label": "a_audit_log", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every expense create, change, stop, removal, and month edit records who, what, and the old and new value."}, {"id": "expenses_net_profit", "label": "Net Profit", "file_type": "rationale", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Net profit on the Overview is contribution profit minus advertising and operating expenses. When no expense exists the figure is contribution only, never a net profit that silently ignores costs."}, {"id": "expenses_ad_account", "label": "f_ad_account", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "expenses_ad_spend", "label": "f_ad_spend_daily", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "expenses_ad_provider", "label": "AdProvider", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/worker/src/ads/sync.ts defines the AdProvider interface and a registry. Providers are added one at a time. Today only manual entry exists. Meta, Google, and TikTok show as not connected yet because each needs a developer app and credentials only the owner can create, and the screen says so instead of pretending."}, {"id": "expenses_ad_sync", "label": "Daily Ad Spend Sync", "file_type": "code", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 06:00 UTC the worker re-reads the last 7 days for every account whose provider has an importer. Spend is upserted by account, date, and campaign, so a second run or a revised platform number never counts spend twice. A failing account is flagged with a generic message because provider errors can echo tokens, and it does not stop the others."}, {"id": "expenses_attribution", "label": "Honest Ad Attribution", "file_type": "rationale", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platform-reported sales are the platform's own claim and are shown apart from Shopify sales. Shopify orders are not matched to campaigns yet, so return is shown blended (all Shopify revenue over all ad spend) and as the platform reports it."}, {"id": "expenses_single_count", "label": "Ad Spend Counted Once", "file_type": "rationale", "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ad spend lowers contribution profit once. Overview, trend, product reconciliation, and reports all use the same figure. Products plus unallocated items, including advertising, equal the Overview figure."}], "edges": [{"source": "expenses_net_profit", "target": "dashboard_overview", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "weight": 1.0}, {"source": "expenses_f_expense", "target": "database_rls", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "weight": 1.0}, {"source": "expenses_override", "target": "database_rls", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "weight": 1.0}, {"source": "expenses_category", "target": "database_rls", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "weight": 1.0}, {"source": "expenses_advertising", "target": "expenses_for_period", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "weight": 1.0}, {"source": "expenses_for_period", "target": "expenses_f_expense", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "weight": 1.0}, {"source": "expenses_for_period", "target": "profit_engine_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/expenses-advertising.md", "source_location": null, "weight": 1.0}, {"source": "expenses_override", "target": "expenses_f_expense", "relation": "references", "confidence": "EXTRACTED", "confidence_score":