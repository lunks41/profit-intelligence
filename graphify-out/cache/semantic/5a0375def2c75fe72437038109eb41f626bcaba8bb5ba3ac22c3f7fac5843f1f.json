{"nodes": [{"id": "securityreview_document", "label": "Security Review", "file_type": "document", "source_file": "docs/security/security-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "securityreview_session_guard", "label": "SessionGuard", "file_type": "code", "source_file": "docs/security/security-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every controller except health and the signed webhook endpoint is behind SessionGuard. The tenant comes from the signed App Bridge token, never from the request. Forged shop or tenant ids are ignored."}, {"id": "securityreview_rls", "label": "Forced Row Level Security", "file_type": "rationale", "source_file": "docs/security/security-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every table with tenant_id has forced row level security and one policy using app_current_tenant(). The application role is not a superuser, cannot bypass RLS, owns no tables, and cannot create objects. Cross-tenant policies are an allow-list. A new table without RLS fails the security integration test."}, {"id": "securityreview_token_encryption", "label": "AES-256-GCM Token Encryption", "file_type": "code", "source_file": "docs/security/security-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shopify access tokens are encrypted at rest with AES-256-GCM and a key id for rotation, and decrypted only in memory. Logs strip secrets by pattern and field name. Requests are logged by route pattern, never by path, query, body, or headers."}, {"id": "securityreview_rotate_shopify_secret", "label": "Rotate Shopify API Secret", "file_type": "rationale", "source_file": "docs/security/security-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The review found a real-looking Shopify secret in .env.example. It was removed, but anyone who saw the file still has it, so a new secret must be created in the Dev Dashboard and stored only in .env."}, {"id": "securityreview_idempotent_jobs", "label": "Idempotent Jobs", "file_type": "rationale", "source_file": "docs/security/security-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg-boss retries a throwing job with backoff and one failure does not stop others. Every job is safe to run twice: syncs and recalculation replace rather than append, so retries cannot double-count money."}, {"id": "securityreview_with_tenant", "label": "withTenant Job Context", "file_type": "rationale", "source_file": "docs/security/security-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every job payload carries tenantId and shopId and runs inside withTenant. Cross-shop jobs use a read-only system context, then switch to the tenant for every write. Job payloads carry ids only."}], "edges": [{"source": "deploymentchecklist_assert_production_config", "target": "securityreview_token_encryption", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/security/security-review.md", "source_location": null, "weight": 1.0}, {"source": "incidentresponse_secret_rotation", "target": "securityreview_rotate_shopify_secret", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/security/security-review.md", "source_location": null, "weight": 1.0}, {"source": "securityreview_document", "target": "monitoring_document", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/security/security-review.md", "source_location