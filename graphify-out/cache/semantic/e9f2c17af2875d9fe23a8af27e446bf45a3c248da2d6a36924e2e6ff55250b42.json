{"nodes": [{"id": "backuprestore_document", "label": "Backup and Restore", "file_type": "document", "source_file": "docs/operations/backup-restore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backuprestore_pg_dump", "label": "PostgreSQL Custom Dump", "file_type": "code", "source_file": "docs/operations/backup-restore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dump covers business data, settings, the audit log, and the job queue. Shopify can re-supply orders, but costs, rules, expenses, ad spend, and the audit log exist only here, which is why backups matter. A SHA-256 manifest and row-count snapshot make an unreadable file fail the run. Suggested retention is 14 daily backups."}, {"id": "backuprestore_verify", "label": "backup:verify", "file_type": "code", "source_file": "docs/operations/backup-restore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A backup that has never been restored is a hope. Verify checks the checksum, restores into a temporary database, compares tables, row counts, forced row level security, policies, and migrations, then always drops the temporary database."}, {"id": "backuprestore_forward_only_migrations", "label": "Forward-Only Migrations", "file_type": "rationale", "source_file": "docs/operations/backup-restore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations are never edited after release and have no down script. Recovery from a bad migration is to restore the backup taken just before it, fix the migration, and run it again. A drop or rewrite must carry an explicit destructive approval or a test fails. Take a backup immediately before every production migration."}], "edges": [{"source": "backuprestore_document", "target": "backupr