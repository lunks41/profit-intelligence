{"nodes": [{"id": "billing", "label": "Billing, Plans, Onboarding and Support", "file_type": "document", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "billing_managed_pricing", "label": "Shopify App Pricing", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommendation: BILLING_MODE=managed. It is the default Shopify steers new public apps to, needs the least code, and the owner controls prices in the Partner Dashboard without a deploy. Shopify is the source of truth: the app reads currentAppInstallation.activeSubscriptions and never stores card details or prices paid."}, {"id": "billing_billing_api", "label": "Billing API", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BILLING_MODE=api is implemented for pricing models managed pricing cannot express, including one-time or unusual pricing. Shopify still supports it and describes it as the older method. The app creates the subscription and sends the merchant to a confirmation URL."}, {"id": "billing_plans", "label": "Plan Catalogue", "file_type": "code", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "packages/contracts/src/plans.ts holds every plan and limit. Nothing else hard-codes a plan check. Growth and Pro prices are drafts (approved false) until the owner approves them."}, {"id": "billing_plan_free", "label": "Free Plan", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "30 days of history, 5 reports a month, no PDF, no scheduled emails, 1 advertising account, no profit leakage findings, draft price $0."}, {"id": "billing_plan_growth", "label": "Growth Plan", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "90 days of history, 50 reports, PDF, 3 scheduled emails, 3 advertising accounts, leakage findings, draft price $29. approved is false, so it cannot be bought in Billing API mode and the screen marks it Draft."}, {"id": "billing_plan_pro", "label": "Pro Plan", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "90 days of history, 500 reports, PDF, 10 scheduled emails, 10 advertising accounts, leakage findings, draft price $79. approved is false. When billing is off, BILLING_OFF_PLAN defaults to pro."}, {"id": "billing_mode_off", "label": "Billing Mode Off", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default for development and beta. Every shop gets BILLING_OFF_PLAN and the history window is not limited, so nothing blocks testing. Subscribing is refused with a clear message."}, {"id": "billing_fail_closed", "label": "Unrecognized Subscription Means Free", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In managed or api mode a shop is on the plan of its active Shopify subscription, otherwise Free. FROZEN, CANCELLED, DECLINED, EXPIRED, PENDING, or an unrecognised plan name all mean Free, so a shop is never given more than it pays for because something did not match."}, {"id": "billing_entitlements", "label": "EntitlementsService", "file_type": "code", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/api/src/billing. Called by every endpoint that has a limit so a direct API request gets the same answer as a click."}, {"id": "billing_plan_limit", "label": "plan_limit 403", "file_type": "code", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "403 plan_limit names the limit and which plan includes it. Enforced for period reach, report files per month, PDF files, scheduled emails, advertising accounts, and leakage findings. Failed report files do not count. The comparison period is held to the same window."}, {"id": "billing_subscribe", "label": "POST /billing/subscribe", "file_type": "code", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns only a Shopify URL: Shopify's plan page in managed mode, or the confirmation URL of a subscription the app creates in api mode. Test charge outside production unless BILLING_TEST_MODE=false."}, {"id": "billing_webhook", "label": "app_subscriptions/update Webhook", "file_type": "code", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The webhook, or the Check my plan again button, makes the app re-read the subscription from Shopify and store it. The webhook payload itself is not trusted."}, {"id": "billing_active_subscriptions", "label": "currentAppInstallation.activeSubscriptions", "file_type": "code", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "billing_onboarding", "label": "Onboarding Checklist", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /session computes the checklist from real data: connected, order history imported, product costs, payment fees, shipping costs, and optional expenses. The card folds away when the required steps are done."}, {"id": "billing_support", "label": "POST /support", "file_type": "code", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores feedback, a question, or a problem with the shop and user from the session, never from the request. A few messages per hour per shop. The form asks not to include customer details. Messages are removed when the shop is purged."}, {"id": "billing_downgrade", "label": "Downgrade Pauses Without Deleting", "file_type": "rationale", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is deleted when a plan gets smaller. The history window only limits what can be viewed. Scheduled emails beyond the new limit are paused, the oldest are kept, and they can be resumed after upgrading. Accounts, expenses, costs, and report files stay. Tested in billing.integration.test.ts."}, {"id": "billing_retention", "label": "Privacy Retention", "file_type": "document", "source_file": "docs/architecture/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_packages_contracts", "target": "billing_plans", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architecture/billing.md", "source_location": null, "weight": 1.0}, {"s