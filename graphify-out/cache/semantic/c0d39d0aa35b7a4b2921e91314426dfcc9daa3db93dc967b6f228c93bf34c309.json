{"nodes": [{"id": "prompt_document", "label": "Profit Intelligence Master Prompt", "file_type": "document", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompt_product_vision", "label": "Profit Intelligence Product Vision", "file_type": "rationale", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The core promise is connect Shopify, calculate real profit, detect profit leakage, explain the cause, and recommend an action. The differentiator is profit transparency, not another generic analytics dashboard. V1 stays focused before an AI CFO or forecasting."}, {"id": "prompt_design_principles", "label": "Product Design Principles", "file_type": "rationale", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Financial transparency beats unexplained numbers. Actual, estimated, and missing data must always be distinguishable. Every important profit figure must be explainable. Build a reliable core before AI, isolate tenants from the start, and keep the stack suitable for a solo developer."}, {"id": "prompt_phase_gate", "label": "Phase Gate", "file_type": "rationale", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implement one phase at a time and stop for approval. Do not claim a command or test succeeded unless it was executed. Keep financial rules in a testable domain layer. Database constraints add integrity and do not replace application authorization."}, {"id": "prompt_financial_contract", "label": "Financial Calculation Contract", "file_type": "rationale", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accounting semantics must be a written reviewed specification, not developer or model assumptions. The starting model is gross sales minus discounts and refunds equals net sales, then minus COGS, shipping cost, payment fees, and advertising equals contribution profit, then minus operating expenses equals estimated net profit. Never silently invent unavailable values. Advertising-attributed revenue is not Shopify revenue."}, {"id": "prompt_profit_leakage", "label": "Profit Leakage Detection", "file_type": "rationale", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first detector is deterministic rules, not an AI dependency. It must not label a condition as a confirmed loss when the underlying cost data is incomplete. Each issue needs evidence, a defensible impact, data limitations, and a next action."}, {"id": "prompt_approved_phase0", "label": "Approved Phase 0 Decisions", "file_type": "rationale", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section 31 records the approved stack: Next.js plus a separate API, NestJS on Fastify, Drizzle, pg-boss with no Redis, pnpm workspaces, RLS with SET LOCAL, Railway gated on a verified restore, no customer PII, 90-day history, and High/Medium/Low profit confidence. Refund timing was to be re-confirmed in the written calculation spec."}, {"id": "prompt_table_naming", "label": "Database Naming Convention", "file_type": "rationale", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section 32 defines singular snake_case tables, prefixes m_ s_ t_ f_ o_ a_, tenant_id as the first business column, and constraint names pk_ fk_ uq_ ix_. Classification follows what the data is and who creates it."}, {"id": "prompt_database_config", "label": "PostgreSQL Database profit_intelligence", "file_type": "rationale", "source_file": "prompt/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section 0.1 names database profit_intelligence. The development superuser is replaced by a least-privilege app_user. The password lives only in the git-ignored .env. Node uses a postgresql:// URL, not a Python driver prefix."}], "edges": [{"source": "adr0001_pg_boss", "target": "prompt_approved_phase0", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "prompt/prompt.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_tenant_rls", "target": "prompt_approved_phase0", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "prompt/prompt.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_no_customer_pii", "target": "prompt_approved_phase0", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "prompt/prompt.md", "source_location": null, "weight": 1.0}, {"source": "figures_estimated_net_profit", "target": "prompt_financial_contract", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "prompt/prompt.md", "source_location": null, "weight": 1.0}, {"source": "prompt_financial_contract", "target": "profitspec_document", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "prompt/prompt.md", "source_location": null, "weight": 1.0}, {"source": "prompt_document", "target": "profitspec_document", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompt/prompt.md", "source_location": null, "weight": 1.0}, {"source": "prompt_document", "target": "webhooks_document", "relation": "cites", "