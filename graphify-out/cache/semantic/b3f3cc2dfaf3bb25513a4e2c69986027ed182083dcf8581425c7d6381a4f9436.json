{"nodes": [{"id": "shopify_auth", "label": "Shopify Installation and Authentication", "file_type": "document", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shopify_managed_install", "label": "Managed Installation", "file_type": "rationale", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes come from shopify.app.toml. There is no OAuth redirect code."}, {"id": "shopify_session", "label": "App Bridge ID Token", "file_type": "code", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT, HS256, signed with the app secret, about 60 seconds. The page calls /api/v1 on its own origin with Authorization Bearer. Next.js rewrites /api/v1 to the api, so the api is never public on its own."}, {"id": "shopify_session_guard", "label": "SessionGuard", "file_type": "code", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies signature, expiry, aud equal to SHOPIFY_API_KEY, and that dest and iss name the same myshopify.com host. No tenant or shop id is ever read from the request."}, {"id": "shopify_token_exchange", "label": "Offline Token Exchange", "file_type": "code", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-expiring offline access token (expiring=false) chosen to avoid refresh concurrency. Revisit if Shopify requires expiring tokens for App Store review."}, {"id": "shopify_install_shop", "label": "installShop", "file_type": "code", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown or returning uninstalled shop: token exchange, shop name, currency, and time zone query, then an idempotent install that creates tenant, shop, and credential in one transaction. Concurrent first requests are safe because of the unique constraint; the loser re-reads. A known active shop makes no call to Shopify."}, {"id": "shopify_encryption", "label": "AES-256-GCM Token Encryption", "file_type": "rationale", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TOKEN_ENCRYPTION_KEY. Access tokens are encrypted before storage, with a key id stored per row for rotation, and are never returned by any endpoint. The API key is public. The API secret and encryption key live only in .env or deployment secrets."}, {"id": "shopify_auth_error", "label": "AuthError", "file_type": "code", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@shopify/shopify-api puts the raw token into its error messages, so the wrapper discards library errors and throws a generic AuthError. Do not log library error text."}, {"id": "shopify_nextjs", "label": "Next.js Client Plus Separate API", "file_type": "rationale", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Option 1 is confirmed viable. No fallback to the React Router template is needed. The api must be started separately. shopify.web.toml works, but the web dev script must read PORT because the CLI assigns a random port."}, {"id": "shopify_frame", "label": "frame-ancestors", "file_type": "rationale", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows https://*.myshopify.com and https://admin.shopify.com. Per-shop restriction can be added later."}, {"id": "shopify_webhooks_phase5", "label": "Webhook Subscriptions Phase 5", "file_type": "document", "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Webhooks use HMAC of the raw body. Subscriptions and compliance topics are Phase 5."}], "edges": [{"source": "database_credential", "target": "shopify_encryption", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "weight": 1.0}, {"source": "shopify_auth", "target": "shopify_managed_install", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "weight": 1.0}, {"source": "shopify_auth", "target": "shopify_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "weight": 1.0}, {"source": "shopify_session", "target": "shopify_session_guard", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "weight": 1.0}, {"source": "shopify_session_guard", "target": "database_resolve_tenant", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "weight": 1.0}, {"source": "shopify_session", "target": "shopify_nextjs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/shopify-auth.md", "source_location": null, "weight": 1.0}, {"source"