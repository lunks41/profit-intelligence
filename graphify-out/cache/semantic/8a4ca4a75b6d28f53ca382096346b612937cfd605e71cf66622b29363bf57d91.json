{"nodes": [{"id": "dashboard", "label": "Dashboard", "file_type": "document", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dashboard_overview", "label": "Dashboard Overview Endpoint", "file_type": "code", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /api/v1/dashboard/overview. Period is in the shop time zone. Presets are 7d, 14d, 30d, 60d, 90d, or custom. The previous period is the same length immediately before. Deltas are relative changes and are null when the previous value is zero. Margin change is in percentage points."}, {"id": "dashboard_summarize", "label": "summarizeFromTotals", "file_type": "code", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Totals come from SQL aggregates over the profit ledger and go through summarizeFromTotals so they equal the engine's entry-based summary."}, {"id": "dashboard_sql", "label": "packages/db/src/dashboard.ts", "file_type": "code", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dashboard_alerts", "label": "Dashboard Alerts", "file_type": "code", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic rules in apps/api/src/dashboard/alerts.ts. Each alert has evidence, why, and an optional action. Lost money is claimed only when every cost for those orders is known; otherwise it says may be losing money."}, {"id": "dashboard_ui", "label": "Overview UI", "file_type": "code", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/web/components/overview. Period, custom dates, and currency filters. Currency choice is kept in localStorage only. KPI cards, Recharts trend with a data-table alternative, confidence and cost breakdowns, and alerts. Display formatting is in lib/format.ts."}, {"id": "dashboard_currency", "label": "Display Currency Conversion", "file_type": "rationale", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amounts are converted per day to the chosen display currency when a rate exists (USD/AED peg). Otherwise the response falls back to the shop currency and says why in currency.note."}, {"id": "dashboard_counted_orders", "label": "Counted Order Statuses", "file_type": "rationale", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only paid, partially refunded, and refunded orders count. Unpaid orders are reported separately as awaiting payment."}, {"id": "dashboard_deferred_products", "label": "Deferred Product Ranking", "file_type": "rationale", "source_file": "docs/architecture/dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top and least profitable products need an approved rule for allocating order-level discounts and refunds to products, so that ranking is part of Phase 8."}], "edges": [{"source": "dashboard", "target": "dashboard_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/dashboard.md", "source_location": null, "weight": 1.0}, {"source": "dashboard_overview", "target": "dashboard_summarize", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_