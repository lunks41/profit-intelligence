{"nodes": [{"id": "adr0001_document", "label": "ADR 0001 Phase 0 Architecture", "file_type": "document", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr0001_nextjs", "label": "Next.js Embedded Client", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js stays the embedded client and calls a separate API. A Phase 3 spike must prove install, token exchange, and an authenticated call. The official React Router template is a fallback only with explicit approval."}, {"id": "adr0001_nestjs_fastify", "label": "NestJS on Fastify", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NestJS on the Fastify adapter is the structured backend. Current Nest releases are ESM-only, so the API, worker, and packages use type module and nodenext. TypeScript is pinned to 6.0.x because typescript-eslint does not yet support 7.x. The Phase 1 worker is a plain Node process until job handlers need shared services."}, {"id": "adr0001_drizzle", "label": "Drizzle ORM", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drizzle is paired with reviewed SQL migrations so schema changes stay explicit rather than hidden behind a generated client."}, {"id": "adr0001_pg_boss", "label": "pg-boss Queue", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg-boss runs on PostgreSQL. Redis is excluded from V1 so the solo-developer stack does not add another operational service."}, {"id": "adr0001_pnpm_workspaces", "label": "pnpm Workspaces", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pnpm workspaces without Turborepo keep the monorepo small. packages/tooling from the Phase 0 layout was dropped; shared config lives in the root tsconfig.base.json and eslint.config.mjs."}, {"id": "adr0001_tenant_rls", "label": "Tenant Isolation", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolation is app-level scoping plus PostgreSQL row level security with SET LOCAL per transaction, fail-closed, and composite foreign keys. Frontend filtering is not a security boundary."}, {"id": "adr0001_railway", "label": "Railway Hosting", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Railway is the V1 host only after a backup restore has been verified. Kubernetes and microservices are avoided unless a concrete requirement appears."}, {"id": "adr0001_no_customer_pii", "label": "No Customer PII in V1", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer personal data is not stored in V1, which keeps privacy webhooks as acknowledgements and avoids a data-use change."}, {"id": "adr0001_table_naming", "label": "Table Naming Prefixes", "file_type": "rationale", "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tables are lowercase snake_case with prefixes m_, s_, t_, f_, o_, and a_ so a name records what the data is and who creates it. Prefixes are not carried into TypeScript names."}], "edges": [{"source": "adr0001_document", "target": "prompt_document", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_document", "target": "adr0001_nextjs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_document", "target": "adr0001_nestjs_fastify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_document", "target": "adr0001_drizzle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_document", "target": "adr0001_pg_boss", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_document", "target": "adr0001_pnpm_workspaces", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_document", "target": "adr0001_tenant_rls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_document", "target": "adr0001_railway", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_document", "target": "adr0001_no_customer_pii", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_table_naming", "target": "prompt_table_naming", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_nextjs", "target": "prompt_approved_phase0", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}, {"source": "adr0001_railway", "target": "backuprestore_verify", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/decisions/0001-phase-0-architecture.md", "source_location": null, "weight": 1.0}], "hyperedges": []}