{"nodes": [{"id": "testdata_document", "label": "Shopify Development Store Seed Data", "file_type": "document", "source_file": "docs/development/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "testdata_pi_seed", "label": "@pi/seed", "file_type": "code", "source_file": "docs/development/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development-only seeder. It never ships with the product. The same seed is deterministic, and sourceIdentifier pi-seed plus the pi-seed tag make re-runs idempotent."}, {"id": "testdata_manifest", "label": "Seed Manifest", "file_type": "code", "source_file": "docs/development/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "packages/seed/out/manifest.json stores Shopify-reported totals per order and month. It is the ground truth for reconciling sync and the profit engine."}, {"id": "testdata_partner_development_guard", "label": "Partner Development Guard", "file_type": "rationale", "source_file": "docs/development/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The seeder refuses to run unless the store reports plan.partnerDevelopment and NODE_ENV is not production, so write traffic cannot hit a live store."}, {"id": "testdata_processed_at", "label": "processedAt as Analytics Date", "file_type": "rationale", "source_file": "docs/development/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "orderCreate honours a past processedAt, but createdAt is always the import time. Analytics must use processed_at. Orders created now are readable without read_all_orders, so this data does not exercise the 60-day created_at limit."}, {"id": "testdata_refund_processed_at", "label": "Date Refunds from refund.processedAt", "file_type": "rationale", "source_file": "docs/development/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "refundCreate honours a past processedAt on the refund, but the REFUND transaction keeps today's timestamp. Refunds must be dated from refund.processedAt, never from the transaction."}, {"id": "testdata_read_only_scopes", "label": "Read-Only Shopify Scopes", "file_type": "rationale", "source_file": "docs/development/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The released app asks for read access only. Write scopes are a temporary seed exception. tests/app-config.test.ts fails while any write scope remains in shopify.app.toml."}, {"id": "testdata_app_config_test", "label": "app-config.test.ts", "file_type": "code", "source_file": "docs/development/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fails the build if shopify.app.toml still contains write scopes, so the seed-time privilege increase cannot ship."}], "edges": [{"source": "testdata_document", "target": "testdata_pi_seed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/test-data.md", "source_location": null, "weight": 1.0}, {"source": "testdata_pi_seed", "target": "testdata_manifest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/test-data.md", "source_location": null, "weight": 1.0}, {"source": "testdata_pi_seed", "target": "testdata_partner_development_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/test-data.md", "source_location": null, "weight": 1.0}, {"source": "testdata_read_onl