{"nodes": [{"id": "retention_document", "label": "Data Retention and Deletion", "file_type": "document", "source_file": "docs/privacy/retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retention_no_customer_pii", "label": "No Stored Customer Personal Data", "file_type": "rationale", "source_file": "docs/privacy/retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer names, emails, addresses, and phone numbers are never requested or stored. A test asserts no table has such a column. Report recipient emails and an optional feedback reply address are merchant-typed, not customer records. Storing customer personal data would require updating this policy and the data-use declaration."}, {"id": "retention_purge_shop_data", "label": "purgeShopData", "file_type": "code", "source_file": "docs/privacy/retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One transaction deletes every row of the shop, the shop, and the tenant when no other shop remains. Row level security limits the delete to that tenant. A test fills every table with a shop id and fails if a new table is not covered."}, {"id": "retention_uninstall_grace", "label": "30-Day Uninstall Grace", "file_type": "rationale", "source_file": "docs/privacy/retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app/uninstalled removes the token at once and schedules a purge in 30 days, skipped if the merchant reinstalled. shop/redact deletes immediately and overrides the grace period. Shopify's required deletion timelines override the 30-day preference."}, {"id": "retention_plan_downgrade", "label": "Plan Downgrade Does Not Delete", "file_type": "rationale", "source_file": "docs/privacy/retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A smaller plan limits what can be viewed, prepared, scheduled, and connected. Nothing is deleted. Scheduled emails over the new limit are paused, not removed. Cancelling a subscription is a change of plan to Free."}, {"id": "retention_report_files_7d", "label": "Report File Retention", "file_type": "rationale", "source_file": "docs/privacy/retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSV and PDF report files are kept 7 days and removed by the nightly cleanup. Orders stay for the 90-day history window. A plan limits how much history can be viewed, never what is kept."}], "edges": [{"source": "retention_document", "target": "webhooks_app_uninstalled", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/privacy/retention.md", "source_location": null, "weight": 1.0}, {"source": "retention_document", "target": "webhooks_shop_redact", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/privacy/retention.md", "source_location": null, "weight": 1.0}, {"source": "retention_document", "target": "webhooks_customer_privacy_ack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/privacy/retention.md", "source_location": null, "weight": 1.0}, {"source": "retention_document", "target": "webhooks_ids_only_payloads", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/privacy/retention.md", "source_location": null, "weight": 1.0}, {"source": "retention_uninstall_grace", "target": "webhooks_app_uninstalled", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/privacy/retention.md", "source_location": null, "weight": 1.0}, {"source": "retention_uninstall_grace", 