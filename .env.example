# Copy to .env (git-ignored) and fill in real values. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL. URL-encode special characters in passwords (@ -> %40, $ -> %24).
# DATABASE_ADMIN_URL = owner/migrator, used only by db:* commands and migrations.
# DATABASE_URL      = app_user, used by the api and worker at runtime (Row Level Security applies).
# Defaults below match the Docker Compose database (pnpm db:up).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/profit_intelligence
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5433/profit_intelligence
APP_DB_PASSWORD=app_user_dev

WEB_PORT=3000
API_PORT=3001
WORKER_HEALTH_PORT=3002

# Shopify app (Dev Dashboard -> your app -> Settings). Secret stays in .env only.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_inventory
SHOPIFY_API_VERSION=2026-10

# Encrypts Shopify access tokens at rest (base64, 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=k1

# ---- Optional settings (all have safe defaults) ----------------------------------------------
# Public https address of the app. REQUIRED in production.
APP_URL=
# Requests allowed per shop per minute (0 turns the limit off).
RATE_LIMIT_PER_MINUTE=600
# Allow a database connection without TLS in production (only on a private network you trust).
# ALLOW_INSECURE_DB=true

# Billing: off (development and beta), managed (Shopify App Pricing) or api (Billing API).
BILLING_MODE=off
# The plan every shop gets while billing is off: free, growth or pro.
BILLING_OFF_PLAN=pro
# The app handle from the Partner Dashboard (needed when billing is on).
SHOPIFY_APP_HANDLE=
# Set to false in production to take real payments.
BILLING_TEST_MODE=true

# Email for scheduled reports. Without SMTP_URL the emails are marked failed and can be retried.
# SMTP_URL=smtps://user:password@mail.example.com:465
# MAIL_FROM="Profit Intelligence <reports@example.com>"
# SUPPORT_EMAIL=support@example.com

# Development only: how many days of orders the importer keeps (default 90, which is what
# production uses; leave unset there). Set to 400 to import seeded history older than 90 days.
# Plan entitlements (what the dashboard may show) are not changed by this.
# ORDER_HISTORY_DAYS=400

# Advertising platforms: sign-in apps registered once by the owner (see docs/operations/ad-platforms.md).
# A platform without its values shows "Not available yet" on the Marketing screen.
# Register the redirect address APP_URL/api/v1/marketing/oauth/<meta|google|tiktok>/callback with each.
# META_APP_ID=
# META_APP_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
