<?xml version="1.0" encoding="utf-8"?>
<!-- IIS runs the web app with HttpPlatformHandler, like the other sites on this server. install.ps1 fills in the two
     placeholders. The web app forwards /api/v1 to the API on this machine (port 3001). -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="__NODE__"
                  arguments="node_modules\next\dist\bin\next start -p %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="__LOGS__\web"
                  startupTimeLimit="90"
                  startupRetryCount="5"
                  requestTimeout="00:05:00">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="API_PORT" value="3001" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
</configuration>
